{
  "name": "rystem.playframework.client",
  "version": "11.0.0",
  "author": "Alessandro Rapiti <alessandro.rapiti44@gmail.com>",
  "license": "MIT",
  "description": "TypeScript client for Rystem PlayFramework HTTP API with step-by-step and token-level streaming support.",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "sideEffects": false,
  "keywords": [
    "rystem",
    "playframework",
    "ai",
    "streaming",
    "sse",
    "typescript",
    "client"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/KeyserDSoze/Rystem.git"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "8.73.0",
    "typescript": "6.0.3"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "/lib"
  ]
}
