{
  "name": "rystem-docs",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Rystem Documentation & MCP Static Site Generator",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "npm run prebuild && tsx server-local.ts",
    "dev:full": "kill-port 3000 && npm run build-mcp && npm run build-a2a && npm run build-skills && concurrently --names \"MCP,VITE\" --prefix-colors \"cyan,magenta\" \"tsx server-local.ts\" \"vite\"",
    "build-docs": "tsx scripts/build-docs.ts",
    "build-mcp": "tsx scripts/build-mcp.ts",
    "build-a2a": "tsx scripts/build-a2a.ts",
    "build-skills": "tsx scripts/build-skills.ts",
    "build-mcp-server": "tsx scripts/build-mcp-server.ts",
    "prebuild": "npm run build-docs && npm run build-mcp && npm run build-a2a && npm run build-skills && npm run build-mcp-server",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@vercel/node": "^32.0.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.6",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/archiver": "^8.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-react": "^6.3.0",
    "archiver": "^8.0.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "glob": "^14.0.6",
    "kill-port": "^2.0.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.8"
  }
}
